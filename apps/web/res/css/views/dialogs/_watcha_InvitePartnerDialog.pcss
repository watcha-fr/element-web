.watcha_InvitePartnerDialog {
    max-width: 32em;

    .mx_Dialog_content {
        margin-bottom: 2em;
    }

    textarea.mx_Field_input,
    .mx_Field textarea {
        resize: vertical;
        min-height: 6em;
        font-family: inherit;
    }

    .watcha_InvitePartnerDialog_hint {
        margin-top: 0.5em;
        font-size: $font-12px;
        opacity: 0.7;
    }

    /* Compteur du plafond, visible dès l'ouverture : discret tant qu'il reste
       de la place, marqué une fois le budget consommé. */
    .watcha_InvitePartnerDialog_budget {
        margin-top: 0.25em;
        font-size: $font-12px;
        opacity: 0.7;
        font-variant-numeric: tabular-nums;
    }

    .watcha_InvitePartnerDialog_budget_full {
        opacity: 1;
        font-weight: 600;
        color: var(--cpd-color-text-info-primary);
    }

    .watcha_InvitePartnerDialog_rejected {
        margin-top: 1em;
        font-size: $font-12px;
        color: var(--cpd-color-text-critical-primary);

        ul {
            margin: 0.5em 0 0;
            padding-left: 1.5em;
            max-height: 8em;
            overflow-y: auto;
        }

        .watcha_InvitePartnerDialog_rejected_address {
            font-weight: 600;
            word-break: break-all;
        }
    }

    /* Le plafond n'est pas une faute de saisie : ton informatif, pas d'erreur,
       contrairement à la liste des adresses écartées ci-dessus. (Le jeu de
       jetons Compound n'expose pas de couleur de texte « warning ».) */
    .watcha_InvitePartnerDialog_overLimit {
        margin-top: 1em;
        font-size: $font-12px;
        color: var(--cpd-color-text-info-primary);
    }
}
