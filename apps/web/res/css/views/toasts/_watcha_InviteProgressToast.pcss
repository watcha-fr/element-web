/* Le nom du salon coiffe le toast : avec une file d'attente, « 12 sur 50 » ne
   dit pas de quel envoi il s'agit. */
.watcha_InviteProgressToast_room {
    font-weight: 600;
    margin-bottom: 0.15em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 272px;
}

/* Ce qui attend derrière, en retrait : l'information est utile mais secondaire. */
.watcha_InviteProgressToast_queued {
    margin-top: 0.45em;
    font-size: $font-12px;
    color: $secondary-content;
}
