/* Set on the shared toast container only while a draggable toast is displayed. */
.mx_ToastContainer.watcha_DraggableToast {
    .mx_Toast_toast {
        cursor: grab;
        /* Without this the browser would scroll instead of letting us move the
           toast on a touch screen. */
        touch-action: none;
    }

    &.watcha_DraggableToast_dragging .mx_Toast_toast {
        cursor: grabbing;
        user-select: none;
    }
}
