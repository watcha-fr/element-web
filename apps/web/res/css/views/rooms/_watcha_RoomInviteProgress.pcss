/* La barre prend la place de l'aperçu du dernier message, sous le nom du salon.
   Sa hauteur doit rester sous celle de cette ligne : les éléments de la liste
   sont virtualisés à hauteur fixe (ROOM_LIST_ITEM_HEIGHT), et une ligne plus
   haute se ferait rogner. */
.watcha_RoomInviteProgress {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    margin-top: 2px;
    height: 14px;

    .mx_ProgressBar {
        flex: 1;
        min-width: 0;
        height: 4px;
    }
}

.watcha_RoomInviteProgress_count {
    flex: none;
    font: var(--cpd-font-body-xs-regular);
    color: var(--cpd-color-text-secondary);
    font-variant-numeric: tabular-nums;
}
